{
  "name": "comfyui-lora-manager-modern-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modern single-page web UI for ComfyUI LoRA Manager (fork-local, served at /lm-ui/)",
  "dependencies": {
    "@vueuse/core": "13.9.0",
    "vue": "3.5.26",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.19.5",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
